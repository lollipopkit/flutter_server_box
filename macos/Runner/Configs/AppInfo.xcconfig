// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2023 tech.lolli. All rights reserved.

// YES or NO, written to the built Info.plist as the boolean FLTEnableImpeller by
// the Runner build phase "Set FLTEnableImpeller". On for every build; the Intel DMG turns
// it off on the command line (scripts/release/release-macos-dmg.sh, macOS CI):
// Impeller's MetalSDF renders glyphs and transitions as noise on an Intel/AMD
// Mac, where Skia is clean (#1798).
// TODO: remove with the overrides once Flutter fixes MetalSDF on Intel/AMD GPUs.
FLT_ENABLE_IMPELLER = YES
