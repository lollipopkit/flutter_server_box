{
  "server": {
    "host": "0.0.0.0",
    "port": 3770,
    "tls": null
  },
  "monitoring": {
    "interval_seconds": 7,
    "rules": [
      {
        "name": "High CPU Usage",
        "monitor_type": "cpu",
        "threshold": ">=77%",
        "matcher": "cpu"
      },
      {
        "name": "High Memory Usage",
        "monitor_type": "memory",
        "threshold": ">=85%",
        "matcher": "memory"
      },
      {
        "name": "High Disk Usage",
        "monitor_type": "disk",
        "threshold": ">=90%",
        "matcher": "disk"
      }
    ]
  },
  "database_url": "sqlite:serverbox_monitor.db",
  "jwt_secret": "your-secret-key-change-this-in-production",
  "push": [
    {
      "name": "webhook",
      "push_type": "webhook",
      "config": {
        "body_template": {
          "message": "Server {{name}}: {{message}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "url": "http://localhost:5700"
      }
    }
  ]
}