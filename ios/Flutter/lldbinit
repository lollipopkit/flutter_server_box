# LLDB startup for the Runner scheme.
#
# Flutter's generated file has to be sourced: it is what the scheme points at
# by default, and a debug build does not attach on recent iOS without it. The
# tooling accepts a custom init file as long as it does this (see
# flutter_tools/lib/src/migrations/lldb_init_migration.dart), so this file has
# to keep the name `flutter_lldbinit` in it. `ephemeral/` is generated by the
# build and gitignored, hence not stopping on the error when it is absent.
command source --relative-to-command-file --stop-on-error false ephemeral/flutter_lldbinit

# The iOS Linux engine (third_party/ish-arm64) interrupts its guest threads
# with SIGUSR1 — on signal delivery, on task exit, and on every timer tick —
# and LLDB stops the whole process on each one by default. That reads as the
# app hanging from the moment Alpine starts. iSH's own ish-lldb.lldb is these
# same three signals.
process handle --notify false --pass true --stop false SIGUSR1 SIGTTIN SIGPIPE
