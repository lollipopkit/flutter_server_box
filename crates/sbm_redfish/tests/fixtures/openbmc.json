      "@odata.id": "/redfish/v1/Chassis/chassis/ThermalSubsystem"
    },
    "PowerSubsystem": {
      "@odata.id": "/redfish/v1/Chassis/chassis/PowerSubsystem"
    },
    "Sensors": {
      "@odata.id": "/redfish/v1/Chassis/chassis/Sensors"
    }
  }
}
