#!/sbin/openrc-run
# The image's part of a boot: installs the agent with install.sh (from the
# package the image carries) whenever it is missing — every live boot, and the
# first boot of a system `sbm-install` wrote — then puts its address on the
# console. Afterwards the agent is an ordinary OpenRC install of install.sh's
# default form: `install.sh upgrade` and `uninstall` work on it as anywhere.

description="ServerBox Monitor: installs the agent from the image"

SHARE=/usr/share/server-box-monitor
RUN_USER=sbm
RUN_HOME=/home/$RUN_USER
# install.sh's directory for an OpenRC agent of an ordinary account.
APP_DIR=$RUN_HOME/.local/share/server-box-monitor
TLS_DIR=$APP_DIR/tls

# Not ordered before the agent's service: install.sh starts that itself, and
# it exists only once installed. sbm-install (setup-disk, through lbu) carries
# this script but not the agent's service: /etc/init.d is not kept unless
# named, see /etc/apk/protected_paths.d/server-box-monitor.list (its entries
# are prefixes, hence this service's name).
depend() {
	need net
	after docker
}

start() {
	ebegin "Setting up ServerBox Monitor"
	ensure_repositories && ensure_account && ensure_tls && ensure_env && ensure_agent
	rc=$?
	eend $rc
	write_console
	return $rc
}

# A live boot lists only the medium, which holds no kernel: sbm-install
# (setup-disk) takes it, the firmware and later updates from Alpine's
# mirror, for the release this system is.
ensure_repositories() {
	grep -q '^https\?://' /etc/apk/repositories 2>/dev/null && return 0
	branch="v$(cut -d. -f1,2 /etc/alpine-release)"
	printf 'https://dl-cdn.alpinelinux.org/alpine/%s/%s\n' "$branch" main "$branch" community >> /etc/apk/repositories
}

ensure_account() {
	# A login shell: the panel's terminal is a PTY for this account. No
	# password: nobody signs in to it but through the agent.
	id "$RUN_USER" >/dev/null 2>&1 || adduser -D -s /bin/ash "$RUN_USER" || return 1
	# A system written by sbm-install has the account (/etc) without its home.
	if [ ! -d "$RUN_HOME" ]; then
		mkdir -p "$RUN_HOME" && chown "$RUN_USER:$RUN_USER" "$RUN_HOME" && chmod 700 "$RUN_HOME"
	fi
	# The web apps are deployed with Docker Compose: the account needs the socket.
	grep -q '^docker:' /etc/group || addgroup -S docker
	addgroup "$RUN_USER" docker >/dev/null 2>&1
	return 0
}

# Acting on the machine needs TLS or a loopback peer, so the agent listens
# over HTTPS from the start, with a certificate made here for this machine.
# The console shows its fingerprint, to check the browser's warning against.
ensure_tls() {
	[ -f "$TLS_DIR/cert.pem" ] && [ -f "$TLS_DIR/key.pem" ] && return 0
	mkdir -p "$TLS_DIR" || return 1
	host=$(hostname)
	san="DNS:$host,DNS:$host.local"
	for ip in $(addresses); do
		san="$san,IP:$ip"
	done
	(
		umask 077
		openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
			-days 3650 -subj "/CN=$host" -addext "subjectAltName=$san" \
			-keyout "$TLS_DIR/key.pem" -out "$TLS_DIR/cert.pem" >/dev/null 2>&1
	) || return 1
	chown -R "$RUN_USER:$RUN_USER" "$RUN_HOME/.local"
}

# install.sh keeps an .env it finds; the JWT secret is left to the agent,
# which makes one on its first start.
ensure_env() {
	[ -f "$APP_DIR/.env" ] && return 0
	{
		cat "$SHARE/pkg/.env.example"
		echo
		echo "# Set by the image: the certificate made on this machine's first boot."
		echo "SBM_TLS_CERT=$TLS_DIR/cert.pem"
		echo "SBM_TLS_KEY=$TLS_DIR/key.pem"
	} > "$APP_DIR/.env" || return 1
	chmod 600 "$APP_DIR/.env" && chown "$RUN_USER:$RUN_USER" "$APP_DIR/.env"
}

ensure_agent() {
	[ -x "$APP_DIR/server_box_monitor" ] && [ -f /etc/init.d/server-box-monitor ] && return 0
	SBM_RUN_USER="$RUN_USER" SBM_INSTALL_PKG="$SHARE/pkg" sh "$SHARE/install.sh" install
}

addresses() {
	ip -4 -o addr show scope global 2>/dev/null | awk '{ split($4, a, "/"); print a[1] }'
}

write_console() {
	ip=$(addresses | head -n 1)
	fingerprint=$(openssl x509 -noout -fingerprint -sha256 -in "$TLS_DIR/cert.pem" 2>/dev/null | cut -d= -f2)
	{
		echo
		echo "ServerBox Monitor: https://${ip:-<this machine>}:3770"
		echo "Certificate SHA-256: ${fingerprint:-unknown}"
		echo "First password (as root): cat $APP_DIR/initial-admin-credentials.txt"
		if grep -q '^[^ ]* / tmpfs ' /proc/mounts; then
			echo
			echo "This system runs from RAM and keeps nothing across a reboot."
			echo "To install it on a disk: sbm-install <disk>"
		fi
		echo
	} > /etc/issue
	cp /etc/issue /etc/motd
}
