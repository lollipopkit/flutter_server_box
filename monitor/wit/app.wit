/// What the agent offers a desk app's backend (`docs/dev/desk-sys.md`).
///
/// An app's own package names its service, as a gRPC service is named:
///
///     package acme:notes;
///     interface api { list: func(folder: string) -> result<list<note>, error>; }
///     interface jobs { reindex: func() -> result<u32, error>; }
///     world notes { include sbm:app/imports; export api; export jobs; }
///
/// `api` functions are unary calls, bounded in time; `jobs` functions run as
/// the app's job (one at a time), their lines streamed to the frame, until
/// they return or are cancelled. Every function returns `result<T, error>`.
/// The frame names a function and passes its parameters as a JSON object;
/// values cross as JSON (`docs/dev/desk-sys.md`, "Values").
///
/// Each call or job is a fresh instance: what lasts goes through `kv`.
package sbm:app@0.1.0;

interface types {
  /// gRPC's canonical status codes an app answers with, and the host too.
  variant error {
    invalid-argument(string),
    not-found(string),
    already-exists(string),
    /// The app does not hold the permission, or no sudo password was given.
    permission-denied(string),
    /// The machine is not in the state this needs (not scanned, changed since).
    failed-precondition(string),
    /// Busy, not on this platform, a tool missing.
    unavailable(string),
    deadline-exceeded,
    cancelled,
    internal(string),
  }

  record output {
    status: s32,
    stdout: list<u8>,
    stderr: list<u8>,
  }
}

interface host {
  use types.{error, output};

  enum level { debug, info, warn, error }

  log: func(level: level, message: string);

  /// `sh -c` with [script], as the agent's account (`process`).
  exec: func(script: string, stdin: option<list<u8>>) -> result<output, error>;

  /// As root (`root`), with the sudo password the caller confirmed in the
  /// desk for this call or job; the app never sees it.
  exec-root: func(script: string) -> result<output, error>;

  /// The app's storage for the calling account: JSON texts by key.
  kv-get: func(key: string) -> option<string>;
  kv-set: func(key: string, value: string) -> result<_, error>;
  kv-remove: func(key: string);

  /// The agent's account's home directory.
  home: func() -> option<string>;

  /// The current status sample (`ServerStatus` JSON, `system`).
  status: func() -> result<string, error>;

  /// The app's own folder on this machine (made 0700 on first use, a tree
  /// `/fs` never serves, removed with the app): for a script to keep what
  /// it fetched or installed there.
  data-dir: func() -> result<string, error>;
}

/// What only the agent knows about this machine.
interface agent {
  use types.{error};

  /// Whether [path] holds the agent's own state (never to be removed).
  holds-state: func(path: string) -> bool;

  /// Folders under the web apps' directory no deployed app owns: (app id,
  /// path).
  stack-leftovers: func() -> list<tuple<string, string>>;

  record web-app {
    id: string,
    /// Its title by locale (`en` always there).
    title: list<tuple<string, string>>,
    /// Where its web UI listens on this machine.
    port: u16,
  }

  /// The web apps deployed here that have a web UI.
  web-apps: func() -> list<web-app>;

  /// One of Agent mode's providers with an address here: the operator's,
  /// or a model server of this machine's.
  record provider {
    id: string,
    name: string,
    /// `openai-completions`, `openai-responses`, `anthropic-messages`.
    api: string,
    base-url: string,
    models: list<string>,
  }

  /// Where a provider is reached, and its key.
  record address {
    api: string,
    base-url: string,
    key: option<string>,
  }

  /// The folder every web app shares (`{shared}`: downloads, media,
  /// `models`).
  shared-dir: func() -> string;

  /// A deployed web app or model server, as the agent keeps it.
  record stack-state {
    id: string,
    /// `installing`, `installed`, `failed`, …
    state: string,
    stopped: bool,
    /// `healthy`, `starting`, `unhealthy`, `down`, `stopped`.
    health: option<string>,
    /// A model server's API port on this machine (its `[llm]` port).
    llm-port: option<u16>,
  }

  /// Every deployed stack, model servers included.
  stacks: func() -> list<stack-state>;

  /// The model servers here changed (one started or stopped outside the
  /// stacks): Agent mode works out which it offers again.
  models-changed: func();

  /// Agent mode's providers (`providers`).
  providers: func() -> result<list<provider>, error>;
  /// [id]'s address and key (`providers`); none for no such provider.
  endpoint: func(id: string) -> result<option<address>, error>;
}

/// HTTP from the agent (`network`): loopback reached directly, anything else
/// through the agent's proxy settings; only a download follows redirects.
interface http {
  use types.{error};

  record request {
    method: string,
    /// `http` or `https`.
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    /// 0: the default (30 s for `fetch`; none for `fetch-lines`, a job's
    /// or a call's own bound applies).
    timeout-secs: u32,
  }

  record response {
    status: u16,
    /// At most 8 MiB.
    body: list<u8>,
  }

  /// A response's body read line by line as it comes.
  resource lines {
    /// The next line, without its line break; none at the end.
    next: func() -> result<option<string>, error>;
  }

  fetch: func(request: request) -> result<response, error>;
  /// The status, and the body as it comes (Ollama's pull progress).
  fetch-lines: func(request: request) -> result<tuple<u16, lines>, error>;
  /// [url]'s body (at most 64 MiB) into the app's own folder as [name]
  /// when its SHA-256 is [sha256] (lowercase hex); its path.
  download: func(url: string, sha256: string, name: string) -> result<string, error>;
}

/// A job's own: nothing here works in a unary call.
interface job {
  use types.{error};

  /// A line of the job's log, streamed to the caller.
  line: func(text: string);

  /// As `host.exec-root`, its output going to the job's log line by line as
  /// it comes; the exit status.
  run-root: func(script: string) -> result<s32, error>;

  /// [script] as the agent's account (`process`), its output going to the
  /// job's log line by line as it comes; the exit status.
  run: func(script: string) -> result<s32, error>;

  /// A file holding [contents] (a token, a key) readable by the agent's
  /// account alone, removed when the job ends; its path, for a script to
  /// read it from, so the secret is never in a script, a log or an argument.
  private-file: func(contents: list<u8>) -> result<string, error>;
}

/// What every app imports; an app's world includes it and exports `api`
/// and, when it has jobs, `jobs`.
world imports {
  import host;
  import agent;
  import http;
  import job;
}
