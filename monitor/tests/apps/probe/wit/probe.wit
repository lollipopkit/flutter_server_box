package test:probe;

interface api {
  use sbm:app/types@0.1.0.{error};

  enum shade { light, very-dark }

  variant shape { circle(u32), none-at-all }

  record echoed {
    text: string,
    count: u32,
    tags: list<string>,
    maybe-note: option<string>,
    shade: shade,
    shape: shape,
  }

  echo: func(text: string, count: u32, tags: list<string>, maybe-note: option<string>, shade: shade, shape: shape) -> result<echoed, error>;
  refuse: func() -> result<_, error>;
  spin: func() -> result<_, error>;
  grow: func() -> result<u32, error>;
  run: func(script: string) -> result<string, error>;
  as-root: func(script: string) -> result<string, error>;
  put: func(key: string, value: string) -> result<_, error>;
  get: func(key: string) -> result<option<string>, error>;
  /// Not a job: `job.line` does nothing here, `run-root` refuses.
  line-outside: func() -> result<_, error>;
}

interface jobs {
  use sbm:app/types@0.1.0.{error};

  count: func(lines: u32) -> result<u32, error>;
  /// Never ends on its own: lines until cancelled.
  forever: func() -> result<_, error>;
}

world probe {
  include sbm:app/imports@0.1.0;
  export api;
  export jobs;
}
