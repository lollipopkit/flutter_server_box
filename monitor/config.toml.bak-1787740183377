database_url = "sqlite:serverbox_monitor.db"

[server]
host = "0.0.0.0"
port = 3770
cors_allowed_origins = []
card_order = []

[monitoring]
interval_seconds = 60
rules = []

[monitoring.extended.idle_pause]
enabled = false

[[push]]
name = "webhook"
push_type = "webhook"
method = "POST"
url = "http://localhost:5700"

[push.body_template]
message = "Server {{name}}: {{message}}"

[push.headers]
Content-Type = "application/json"

[[push]]
name = "serverchan"
push_type = "serverchan"
desp = "{{message}}"
sc_key = ""
title = "ServerBox Monitor"

[[push]]
name = "bark"
push_type = "bark"
body = "{{message}}"
key = ""
level = "active"
server = "https://api.day.app"
title = "ServerBox Monitor"

[[push]]
name = "ios"
push_type = "ios"
body_regex = ".*"
code = 200
content = "{{message}}"
title = "ServerBox Monitor"
token = ""

[remote_access]
ssh_addr = "127.0.0.1:22"
full_access = false

[remote_access.terminal]
enabled = false
detached_timeout_secs = 300
allow_insecure = false

[remote_access.fs]
enabled = false
roots = []
allow_insecure = false
