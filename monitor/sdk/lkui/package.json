{
  "name": "lkui",
  "version": "0.1.0",
  "description": "Build apps for the ServerBox monitor's desk: the client of its app bridge, drawn in the lollipopkit Design System.",
  "keywords": ["serverbox", "desk", "lollipopkit"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lollipopkit/flutter_server_box.git",
    "directory": "monitor/sdk/lkui"
  },
  "homepage": "https://github.com/lollipopkit/flutter_server_box/blob/main/docs/dev/desk-sys.md",
  "license": "Apache-2.0"
}
