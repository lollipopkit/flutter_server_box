# Server Configuration
SBM_HOST=0.0.0.0
SBM_PORT=3770

# TLS Configuration (optional)
# SBM_TLS_CERT=/path/to/cert.pem
# SBM_TLS_KEY=/path/to/key.pem

# Database Configuration
DATABASE_URL=sqlite:serverbox_monitor.db

# JWT secret (optional): auto-generated on first start when unset, persisted as
# jwt.secret next to the database; explicit values must be >= 32 characters
# JWT_SECRET=

# Logging
RUST_LOG=info
# Comma-separated origins allowed to call the API cross-origin
# (panel hosted on Cloudflare Pages etc.); unset = same-origin only
# SBM_CORS_ORIGINS=https://panel.example.pages.dev
