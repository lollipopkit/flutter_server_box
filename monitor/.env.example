# Server Configuration
SBM_HOST=0.0.0.0
SBM_PORT=3770

# TLS Configuration (optional)
# SBM_TLS_CERT=/path/to/cert.pem
# SBM_TLS_KEY=/path/to/key.pem

# Database Configuration
DATABASE_URL=sqlite:serverbox_monitor.db

# JWT Secret(可选):未设置时首启自动生成,持久化在数据库同目录 jwt.secret;
# 显式设置需 >= 32 字符
# JWT_SECRET=

# Logging
RUST_LOG=info