# Rust workspace
/target/
/target-alpine/

# Runtime artifacts of a locally-run monitor agent. `monitor/.gitignore`
# already covers these when it runs from its own directory; these rules catch
# the case where it was started from the repo root instead.
/config.toml
/jwt.secret

# SQLite databases (monitor's metrics store, and anything else local)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Agent scratch space: worktrees here are checkouts of this same repo.
.claude/worktrees/
# Widget Preview related
.widget_preview/

# Built by scripts/build-proot-android.sh — GPL binaries, not sources.
/android/app/src/main/jniLibs/
/build/proot-android/

# Local switch for the iOS Linux engine — see ios/Flutter/Ish.xcconfig.
/ios/Flutter/IshLocal.xcconfig

# The working scratchpad for what is not done yet. Kept on disk, out of the
