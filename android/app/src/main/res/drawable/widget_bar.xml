<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded meter: the track, and the reading clipped from the start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="@color/widgetTrack" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape>
                <corners android:radius="4dp" />
                <solid android:color="@color/widgetAccent" />
            </shape>
        </clip>
    </item>
</layer-list>
