<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget, at any size: what it shows follows the space it is given
    (`HomeWidget.formFor`), from one row up. 4x2 when first placed.

    `reconfigurable` puts "Customise" on the long-press menu (API 31+), so a
    tap can open the server rather than the settings.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="tech.lolli.toolbox.widget.WidgetConfigureActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_message"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
