<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The product name, the same in every language. Marked untranslatable
         rather than translated into each: a brand name that varies by locale
         is a different app to its users, and lint counts a missing one as an
         error. -->
    <string name="app_name" translatable="false">ServerBox</string>

    <!--
        Widget strings live here rather than in the app's ARB files: they are
        drawn by native code in a process the Flutter engine may never have
        started in, so `l10n` is not reachable. Only what a widget or its
        configuration screen actually shows.
    -->
    <string name="widget_chart_desc">Status charts</string>
    <string name="widget_refresh_desc">Refresh</string>

    <string name="widget_configure_title">Widget</string>
    <string name="widget_configure_server">Server</string>
    <string name="widget_configure_metric">Leading metric</string>
    <string name="widget_configure_save">Save</string>
    <!--
        Shown when the app has published no server with a monitor agent. The
        widget reads a list this app writes, so there is nothing to pick from
        until one exists — and it has to be added in the app, since reaching an
        agent needs a login the widget has nowhere to keep.
    -->
    <string name="widget_configure_empty">No server with a monitor agent yet.\nAdd one in ServerBox, then come back.</string>


    <string name="widget_metric_cpu">CPU</string>
    <string name="widget_metric_memory">Memory</string>
    <string name="widget_metric_disk">Disk</string>
    <string name="widget_metric_network">Network</string>

    <string name="widget_err_not_configured">Tap to pick a server</string>
    <string name="widget_err_no_token">No credential — open ServerBox</string>
    <string name="widget_err_insecure">HTTPS required</string>
    <string name="widget_err_network">Network error</string>
    <string name="widget_err_timeout">Timed out</string>

    <string name="widget_small_label">Server readings</string>
    <string name="widget_medium_label">Server charts</string>
    <string name="widget_label">Server status</string>
    <string name="widget_description">CPU, memory, disk and network at a glance. Resize it to see more.</string>

    <!-- Quick Settings tile, the transfer notification's channel, the text
         selection entry, and what a share that could not be read says. Native,
         since the tile and the channel exist without the Flutter engine. -->
    <string name="process_text_label">Save as snippet</string>
    <string name="tile_no_sessions">No active sessions</string>
    <plurals name="tile_sessions">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessions</item>
    </plurals>
    <string name="channel_transfers">File transfers</string>
    <string name="incoming_failed">Could not take in the shared files</string>
    <string name="shortcut_server_gone">Server removed</string>
</resources>
