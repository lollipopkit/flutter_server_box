<?xml version="1.0" encoding="utf-8"?>
<!--
    Tall (about 4x3 and up): `widget_medium` with a second trend, the next
    metric's, between the leading one and the meters. Ids as in `widget_small`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="@color/widgetAccent" />

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="google-sans-medium"
            android:singleLine="true"
            android:textColor="@color/widgetOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="google-sans-text"
            android:singleLine="true"
            android:textColor="@color/widgetOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="-4dp"
            android:contentDescription="@string/widget_refresh_desc"
            android:padding="4dp"
            android:src="@drawable/refresh_24" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="84dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/hero_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
            A trend drawn as an alpha mask and coloured here, so the colour
            follows the theme and wallpaper as the launcher resolves them —
            see `WidgetChart`.
        -->
        <ImageView
            android:id="@+id/hero_chart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_chart_desc"
            android:scaleType="fitXY"
            android:tint="@color/widgetAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/second_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/second_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-medium"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/second_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_chart_desc"
            android:scaleType="fitXY"
            android:tint="@color/widgetAccentSecondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/s1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-medium"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/s1_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar" />

            <ProgressBar
                android:id="@+id/s1_bar_warn"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar_warn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/s2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/s2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-medium"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/s2_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar" />

            <ProgressBar
                android:id="@+id/s2_bar_warn"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar_warn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/s3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/s3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="google-sans-medium"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/s3_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar" />

            <ProgressBar
                android:id="@+id/s3_bar_warn"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar_warn"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
