<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing to show yet, or a fetch that failed: the server and why. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="@color/widgetWarn" />

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="google-sans-medium"
            android:singleLine="true"
            android:textColor="@color/widgetOnSurface"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="-4dp"
            android:contentDescription="@string/widget_refresh_desc"
            android:padding="4dp"
            android:src="@drawable/refresh_24" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="google-sans-text"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="3"
        android:textColor="@color/widgetOnSurfaceVariant"
        android:textSize="13sp" />
</LinearLayout>
