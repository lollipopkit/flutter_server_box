<?xml version="1.0" encoding="utf-8"?>
<!--
    One layout for every size, with rows and the chart shown or hidden per
    update. `RemoteViews` cannot hold a custom view, so the charts are a single
    `ImageView` that Kotlin draws every panel into — see `WidgetChart`. That is
    also why there is one image rather than four: four bitmaps in one
    `RemoteViews` is four times the binder payload, and the transaction has a
    hard limit that a widget cannot recover from.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widgetText"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Server Name" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widgetSummaryText"
            android:textSize="10sp"
            tools:text="12:34" />
    </LinearLayout>

    <!-- The charts, all of them, as one bitmap. -->
    <ImageView
        android:id="@+id/widget_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_chart_desc"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_cpu_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_cpu_desc"
                android:src="@drawable/speed_24" />

            <TextView
                android:id="@+id/widget_cpu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widgetSummaryText"
                android:textSize="12sp"
                tools:text="CPU 25%" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_mem_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_mem_desc"
                android:src="@drawable/memory_24" />

            <TextView
                android:id="@+id/widget_mem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widgetSummaryText"
                android:textSize="12sp"
                tools:text="MEM 4.2g / 8.0g" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_disk_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_disk_desc"
                android:src="@drawable/storage_24" />

            <TextView
                android:id="@+id/widget_disk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widgetSummaryText"
                android:textSize="12sp"
                tools:text="DISK 125g / 250g" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_net_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_net_desc"
                android:src="@drawable/net_24" />

            <TextView
                android:id="@+id/widget_net"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widgetSummaryText"
                android:textSize="12sp"
                tools:text="NET 15m / 8m" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="3"
        android:textColor="@color/widgetSummaryText"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Network error" />

</LinearLayout>
