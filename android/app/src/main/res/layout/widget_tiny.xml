<?xml version="1.0" encoding="utf-8"?>
<!--
    One row high (2x1, 4x1): the server and its leading reading, and the next
    two as text on the right when there is room for them. Ids as in
    `widget_small`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot"
                android:tint="@color/widgetAccent" />

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="google-sans-medium"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurface"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/hero_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="google-sans-text"
                android:singleLine="true"
                android:textColor="@color/widgetOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tiny_side"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/s1_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="google-sans-text"
            android:singleLine="true"
            android:textColor="@color/widgetOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/s2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="google-sans-text"
            android:singleLine="true"
            android:textColor="@color/widgetOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
