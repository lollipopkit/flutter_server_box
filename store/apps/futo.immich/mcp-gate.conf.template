# Written for ServerBox Monitor: the gate in front of the MCP server, which
# answers anyone otherwise. nginx's image fills ${MCP_TOKEN} in at start
# (envsubst over the variables it is given; nginx's own `$…` stay).
server {
    listen 8080;

    location = /mcp {
        if ($http_authorization != "Bearer ${MCP_TOKEN}") {
            return 401;
        }
        proxy_pass http://mcp:8626/mcp;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        # Streamable HTTP answers as an event stream: passed on as it comes.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        return 404;
    }
}
