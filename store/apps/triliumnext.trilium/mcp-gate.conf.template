# Written for ServerBox Monitor: the gate in front of Trilium's MCP server
# (/mcp), which asks for an ETAPI token. It asks Agent mode for MCP_TOKEN and
# passes requests on with the token seed-mcp made, or the one set in the
# app's settings (TRILIUM_ETAPI_TOKEN, read at start): the agent never holds
# it. nginx's image fills ${MCP_TOKEN} and ${TRILIUM_ETAPI_TOKEN} in at start
# (envsubst over the variables it is given; nginx's own `$…` stay).
server {
    listen 8080;

    location = /mcp {
        if ($http_authorization != "Bearer ${MCP_TOKEN}") {
            return 401;
        }
        proxy_pass http://trilium:8080/mcp;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization "Bearer ${TRILIUM_ETAPI_TOKEN}";
        # Streamable HTTP answers as an event stream: passed on as it comes.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        return 404;
    }
}
